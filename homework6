public class student{
    String name;
    String year;
    double gpa;
    int id;
    public student(String n, String y, double g, int i){
        name = n;
        year = y;
        gpa = g;
        id = i;}
    public boolean ishonorroll(){
        return this.gpa > 3.6;
    }
    public void freelunch(int randomid){
