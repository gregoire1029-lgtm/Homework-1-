    public static int sumn(int number){
        int sum = 0;
        for (int i = 1; i <= number; i += 2){
            sum = sum + i;}return sum;}
    public static String reverse(String text){
        String reverse = "";
        for (int i = text.length() - 1; i >= 0; i--){reverse = reverse + text.charAt(i);
        }return reverse;}
    //second part of assignment figures out which plates go on each side of a 45 lb bar
    public static String calculator(double target){
        double plates[] = {45, 35, 25, 10, 5, 2.5};
        double perside = (target - 45) / 2;
        String answer = "each side: ";
        for (int i = 0; i < plates.length; i++){
            int count = 0;
            while (perside >= plates[i]){
                perside = perside - plates[i];
                count = count + 1;
            }
            if (count > 0){
                answer = answer + count + " x " + plates[i] + ", ";
            }}return answer;
    }}
